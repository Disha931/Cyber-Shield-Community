<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Learning Center"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Build your cyber-awareness, one topic at a time."
            android:textColor="@color/txtSecond"
            android:textSize="13sp" />

        <!-- 🔵 NEW — progress summary -->
        <TextView
            android:id="@+id/tvLearnProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:text="0/6 topics completed"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Category: Awareness -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAwareness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_dialog_info"
                    android:contentDescription="@null"
                    app:tint="@color/blue_light" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cyber Awareness Basics"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Core habits for staying safe online"
                        android:textColor="@color/txtSecond"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 🔵 NEW -->
                <ImageView
                    android:id="@+id/ivCheckAwareness"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/checkbox_on_background"
                    android:contentDescription="Completed"
                    android:visibility="gone"
                    app:tint="@color/Safegreen" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Category: Phishing -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPhishing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/stat_sys_warning"
                    android:contentDescription="@null"
                    app:tint="@color/Dangerred" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phishing &amp; Scams"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Spot fake links, emails and messages"
                        android:textColor="@color/txtSecond"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 🔵 NEW -->
                <ImageView
                    android:id="@+id/ivCheckPhishing"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/checkbox_on_background"
                    android:contentDescription="Completed"
                    android:visibility="gone"
                    app:tint="@color/Safegreen" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Category: Passwords -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPasswords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_lock_lock"
                    android:contentDescription="@null"
                    app:tint="@color/accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Password Security"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Build strong, unique passwords"
                        android:textColor="@color/txtSecond"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 🔵 NEW -->
                <ImageView
                    android:id="@+id/ivCheckPasswords"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/checkbox_on_background"
                    android:contentDescription="Completed"
                    android:visibility="gone"
                    app:tint="@color/Safegreen" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Category: Privacy -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPrivacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_view"
                    android:contentDescription="@null"
                    app:tint="@color/Safegreen" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Privacy Protection"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Control what you share online"
                        android:textColor="@color/txtSecond"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 🔵 NEW -->
                <ImageView
                    android:id="@+id/ivCheckPrivacy"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/checkbox_on_background"
                    android:contentDescription="Completed"
                    android:visibility="gone"
                    app:tint="@color/Safegreen" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Category: Malware -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMalware"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_dialog_alert"
                    android:contentDescription="@null"
                    app:tint="@color/Dangerred" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Malware &amp; Viruses"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Recognize and avoid malicious software"
                        android:textColor="@color/txtSecond"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 🔵 NEW -->
                <ImageView
                    android:id="@+id/ivCheckMalware"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/checkbox_on_background"
                    android:contentDescription="Completed"
                    android:visibility="gone"
                    app:tint="@color/Safegreen" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Category: Web Security -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardWebSecurity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_mapmode"
                    android:contentDescription="@null"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Web Security &amp; Safe Practices"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Browse and shop safely online"
                        android:textColor="@color/txtSecond"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 🔵 NEW -->
                <ImageView
                    android:id="@+id/ivCheckWebSecurity"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/checkbox_on_background"
                    android:contentDescription="Completed"
                    android:visibility="gone"
                    app:tint="@color/Safegreen" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>